OPENROUTER_API_KEY=
# primary free model, then comma-separated fallbacks (names change often: check openrouter.ai/models?q=free)
MODEL=meta-llama/llama-3.3-70b-instruct:free
FALLBACK_MODELS=google/gemma-3-27b-it:free,mistralai/mistral-small-3.1-24b-instruct:free
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dar-wasalt-chatbot
# MLflow (docker-compose sets this automatically; leave empty to use local ./mlruns)
MLFLOW_TRACKING_URI=
